dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: to attrs=userPassword by self write by dn="cn=admin,dc=example,dc=com" write by anonymous auth by * none
olcAccess: to * by self read by dn="cn=crm-service,ou=people,dc=example,dc=com" read by dn="cn=admin,dc=example,dc=com" write by * break
